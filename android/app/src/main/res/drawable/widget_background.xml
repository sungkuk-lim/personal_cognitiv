<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="145"
                android:centerColor="#FF12102A"
                android:endColor="#FF0A0818"
                android:startColor="#FF1E1240"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item
        android:gravity="top|end"
        android:drawable="@drawable/widget_graph_network" />
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.85"
                android:centerY="0.15"
                android:endColor="#00000000"
                android:gradientRadius="180dp"
                android:startColor="#337C4DFF"
                android:type="radial" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
