# 로컬 비밀키 예시 — 실제 값은 secrets.local.json 또는 .env.local 에 저장하세요.
# 빌드/실행 시 scripts/run_dev.ps1 · scripts/build_release.ps1 가 secrets.local.json 을 읽습니다.

AI_OMAKASE_API_KEY=sk-proj-your-key-here

# 선택: OpenAI 호환 STT 엔드포인트·모델 (기본값 아래와 동일)
# AI_OMAKASE_STT_URL=https://api.openai.com/v1/audio/transcriptions
# AI_OMAKASE_STT_MODEL=gpt-4o-mini-transcribe

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
